# ---- 后端 API ----
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# 开发库
DATABASE_URL=postgres://tw_app:tw_app_pwd_2026@127.0.0.1:5432/teacher_workbench
# 测试库（集成测试使用，会被反复重建）
TEST_DATABASE_URL=postgres://tw_app:tw_app_pwd_2026@127.0.0.1:5432/teacher_workbench_test

# JWT —— 生产环境必须替换为随机且保密的独立密钥，否则服务拒绝启动
JWT_SECRET=teacher-workbench-dev-secret-change-me
JWT_EXPIRES_IN=12h

# 登录限流：同一来源在窗口内的最大尝试次数。
# 代码内默认较严（10 次/分钟）；这里放宽是为了避免本地自动化测试被误伤。
# 生产环境请按实际需要调小。
LOGIN_RATE_LIMIT_MAX=200
LOGIN_RATE_LIMIT_WINDOW=1 minute

# 允许的前端来源
CORS_ORIGIN=http://localhost:5173

# ---- 前端 Web ----
# 后端接口基地址。留空则走同源 `/api`，由 Vite 代理转发到后端。
# 部署到与后端不同源时，把它设为后端的完整地址。
VITE_API_BASE_URL=

# ---- 演示账号种子 ----
SEED_DEFAULT_PASSWORD=Teach@2026
